# Server
PORT=8787
BASE_URL=https://your-public-hostname.example.com

# Maestro
MAESTRO_TRIGGER_URL=https://<your-maestro-http-trigger-url>
MAESTRO_EVENT_URL=https://<your-maestro-external-event-ingest-url>
MAESTRO_BEARER_TOKEN=replace_me

# Notion
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Action link signing (HMAC)
ACTION_TOKEN_SECRET=super_long_random_string

# Defaults for sender (Developer)
DEVELOPER_NAME="Raileen Del Rosario"
DEVELOPER_EMAIL="you@example.com"
